{
  "name": "Shield Guard Telegram Bot",
  "description": "Telegram group security and moderation bot",
  "keywords": [
    "telegram",
    "moderation",
    "antispam",
    "python"
  ],
  "env": {
    "BOT_TOKEN": {
      "description": "Telegram bot token from @BotFather",
      "required": true
    },
    "OWNER_ID": {
      "description": "Telegram numeric user ID for owner-only commands",
      "required": true
    },
    "OWNER_USERNAME": {
      "description": "Owner Telegram username without @",
      "required": false,
      "value": "YourOwnerUsername"
    },
    "SUPPORT_USERNAME": {
      "description": "Support Telegram username without @",
      "required": false,
      "value": "YourSupportUsername"
    },
    "LOG_CHAT_ID": {
      "description": "Optional Telegram chat ID for moderation logs",
      "required": false,
      "value": ""
    },
    "MONGO_DB_URI": {
      "description": "MongoDB Atlas connection string",
      "required": false,
      "value": ""
    },
    "MONGO_DB_NAME": {
      "description": "MongoDB database name",
      "required": false,
      "value": "shield_guard"
    }
  }
}
